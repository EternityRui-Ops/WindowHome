<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="窗归 · WindowHome" Width="1160" Height="770" MinWidth="990" MinHeight="690" Background="#F4F6FA" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#17263C" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#087F73"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E0E8"/><Setter Property="Foreground" Value="#22354B"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#087F73"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#087F73"/><Setter Property="BorderBrush" Value="#087F73"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="#142238"/><Setter Property="BorderBrush" Value="#142238"/><Setter Property="Foreground" Value="#BDCADB"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Padding" Value="20,13"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#E3E9F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#728096"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CED8E3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,9,0,9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EEF2F6"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="RowHeight" Value="40"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F5F8FB"/><Setter Property="Foreground" Value="#738095"/><Setter Property="Padding" Value="10,10"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111E31"><Grid Margin="14,25,14,18"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top"><Grid Width="27" Height="27" Margin="0,3,10,0"><Border BorderBrush="#59D7C5" BorderThickness="2" CornerRadius="5"/><Border Background="#59D7C5" Width="10" Height="10" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/><Border Background="#59D7C5" Width="6" Height="13" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/></Grid><TextBlock Text="窗归" FontSize="25" FontWeight="Bold" Foreground="White"/></StackPanel>
   <StackPanel Grid.Row="1"><Button x:Name="NavLayouts" Content="▤    布局" Style="{StaticResource Nav}"/><Button x:Name="NavReports" Content="✓    恢复记录" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" Content="⚙    设置" Style="{StaticResource Nav}"/></StackPanel>
   <TextBlock Grid.Row="2" Text="v1.1.0" Foreground="#657E99" FontSize="10" Margin="10,0,0,0"/>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="24,22,24,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageTitle" Text="布局" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#E3F3EE" CornerRadius="14" Padding="12,6" Margin="0,0,10,0"><TextBlock x:Name="StatusLabel" Text="● 自动管理中" Foreground="#087F73" FontSize="12"/></Border><Button x:Name="PauseButton" Content="暂停" Padding="14,7" Margin="0"/></StackPanel></Grid>
   <Grid x:Name="Pages" Grid.Row="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,0,0,14"><StackPanel><DockPanel Margin="0,0,0,12"><TextBlock x:Name="TargetLabel" Text="尚无恢复目标" Foreground="#087F73" FontWeight="SemiBold"/><TextBlock x:Name="TargetHint" Style="{StaticResource Muted}" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel><WrapPanel><Button x:Name="RestoreButton" Content="一键恢复" Style="{StaticResource Primary}"/><Button x:Name="SaveButton" Content="＋ 保存布局"/><Button x:Name="UndoButton" Content="撤销恢复"/><Button x:Name="LaunchButton" Content="启动软件…" Margin="0"/></WrapPanel></StackPanel></Border>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="198"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="10"><DockPanel><StackPanel DockPanel.Dock="Top"><Button x:Name="CurrentDesktopButton" Content="当前桌面" Margin="0,0,0,10" HorizontalContentAlignment="Left"/><TextBlock Text="已保存的布局" Style="{StaticResource Muted}" FontSize="11" Margin="8,3,0,8"/></StackPanel><ListBox x:Name="LayoutList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,9"><TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="#728096" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="17" Margin="13,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><DockPanel><TextBlock x:Name="LayoutTitle" Text="当前桌面" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CurrentSummary" Style="{StaticResource Muted}" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel><TextBlock x:Name="LayoutInfo" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,8"/><Grid><Canvas x:Name="DesktopCanvas" Height="140" Background="#F6F8FB" ClipToBounds="True"/><Canvas x:Name="LayoutCanvas" Height="140" Background="#F6F8FB" ClipToBounds="True" Visibility="Collapsed"/></Grid><TextBlock x:Name="DisplayLabel" Style="{StaticResource Muted}" FontSize="10" Margin="0,7,0,10"/></StackPanel>
       <Grid Grid.Row="1"><WrapPanel x:Name="CurrentActions" Margin="0,0,0,10"><Button x:Name="RefreshButton" Content="刷新" Padding="12,6"/><Button x:Name="ExcludeButton" Content="排除选中应用" Padding="12,6"/></WrapPanel><WrapPanel x:Name="LayoutActions" Margin="0,0,0,4" Visibility="Collapsed"><Button x:Name="RestoreLayoutButton" Content="恢复此布局" Style="{StaticResource Primary}" Padding="12,7" Margin="0,0,7,7"/><Button x:Name="DefaultButton" Content="设为默认" Padding="12,7" Margin="0,0,7,7"/><Button x:Name="UpdateLayoutButton" Content="更新" Padding="12,7" Margin="0,0,7,7"/><Button x:Name="RenameButton" Content="重命名" Padding="12,7" Margin="0,0,7,7"/><Button x:Name="DeleteLayoutButton" Content="删除" Padding="12,7" Margin="0,0,0,7"/></WrapPanel></Grid>
       <Grid Grid.Row="2"><TextBlock x:Name="EmptyLabel" Text="暂无窗口" Style="{StaticResource Muted}" Margin="0,10,0,0"/><DataGrid x:Name="WindowGrid"><DataGrid.Columns><DataGridTextColumn Header="应用" Binding="{Binding AppName}" Width="105" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="窗口" Binding="{Binding DisplayTitle}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="位置与尺寸" Binding="{Binding Geometry}" Width="195" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid></Grid>
      </Grid></Border>
     </Grid>
    </Grid>
    <Grid Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,12"><TextBox x:Name="ReportSearch" Width="235" Height="35" Margin="0,0,9,7" ToolTip="搜索方案、应用、窗口或说明" AutomationProperties.Name="搜索恢复记录"/><ComboBox x:Name="ReportOutcome" Width="125" Height="35" Margin="0,0,9,7" SelectedIndex="0"><ComboBoxItem Content="全部结果"/><ComboBoxItem Content="全部成功"/><ComboBoxItem Content="部分成功"/><ComboBoxItem Content="未成功"/></ComboBox><ComboBox x:Name="ReportTrigger" Width="125" Height="35" Margin="0,0,9,7" SelectedIndex="0"><ComboBoxItem Content="全部方式"/><ComboBoxItem Content="手动恢复"/><ComboBoxItem Content="自动恢复"/><ComboBoxItem Content="启动软件"/><ComboBoxItem Content="撤销"/></ComboBox><TextBlock x:Name="ReportCount" Text="0 / 100 条" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,7"/></WrapPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="8"><ListBox x:Name="ReportList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7,8"><TextBlock Text="{Binding Caption}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding TriggerGroup}" FontSize="10" Foreground="#728096" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="13,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ReportSummary" Text="暂无记录" Foreground="#087F73" TextWrapping="Wrap" Margin="0,0,0,12"/><DataGrid x:Name="ReportGrid" Grid.Row="1" RowHeight="NaN"><DataGrid.Columns><DataGridTextColumn Header="应用" Binding="{Binding AppName}" Width="95" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="窗口" Binding="{Binding WindowTitle}" Width="*" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="结果" Binding="{Binding ResultStatus}" Width="72"/><DataGridTextColumn Header="说明" Binding="{Binding ResultDetail}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="0,6"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Grid></Border></Grid>
    </Grid>
    <Grid Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,4,0"><Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="自动管理" FontSize="16" FontWeight="SemiBold"/><CheckBox x:Name="LearningCheck" Content="自动记住稳定的窗口摆放"/><CheckBox x:Name="DisplayCheck" Content="显示器重连后恢复"/><CheckBox x:Name="WakeCheck" Content="唤醒或解锁后恢复"/><CheckBox x:Name="NewCheck" Content="恢复新窗口的位置"/><CheckBox x:Name="StartupCheck" Content="登录 Windows 后启动窗归"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="快捷键与应用排除" FontSize="16" FontWeight="SemiBold"/><Grid Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><TextBlock Text="恢复布局" Style="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="RestoreKeyBox" ToolTip="例如 Ctrl+Alt+R，留空关闭"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="保存布局" Style="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="SaveKeyBox" ToolTip="例如 Ctrl+Alt+S，留空关闭"/></StackPanel></Grid><TextBlock Text="排除应用（每行一个程序名或完整路径）" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="ExcludedBox" AcceptsReturn="True" Height="85" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/></StackPanel></Border><WrapPanel Margin="0,0,0,14"><Button x:Name="ApplySettingsButton" Content="保存设置" Style="{StaticResource Primary}"/><Button x:Name="OpenDataButton" Content="数据目录"/></WrapPanel><TextBlock x:Name="DataPathLabel" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid>
   </Grid>
   <TextBlock x:Name="MessageLabel" Grid.Row="2" Text="就绪" Foreground="#728096" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>